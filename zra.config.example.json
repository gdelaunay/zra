// Configuration de zra-daemon — modèle à copier en `zra.config.json` à la
// racine (fichier propre au poste, non suivi par git ; `ZRA_CONFIG` peut pointer
// ailleurs). Les commentaires sont tolérés (JSONC), comme dans le settings.json
// de Zed. Surchargeable par variables d'environnement (ZRA_PORT,
// ZRA_REQUIRE_TUNNEL…) et par les options de la ligne de commande.
{
  "port": 7777,

  // Écoute. Jamais 0.0.0.0 : la loopback, le réseau local et le
  // tunnel éventuel, chacun sur son adresse. Hors loopback, appairage obligatoire.
  //
  // Réseau local (IPv4 privées) : le téléphone sur le même Wi-Fi, et à distance
  // à travers un tunnel « tout le trafic » (wg-easy, AllowedIPs 0.0.0.0/0) qui
  // débouche sur ce réseau. Jamais un réseau marqué « Public » (Windows).
  // "lanCidrs" : le restreindre, ex. ["192.168.1.0/24"] — recommandé sous Linux.
  "bindLan": true,
  "lanCidrs": null,
  // Tunnel monté sur le poste lui-même (facultatif) : "bindInterface" est le nom
  // de son adaptateur, "bindCidr" un repli par plage ; sinon détection par nom.
  "bindTunnel": true,
  "bindInterface": null,
  "bindCidr": null,
  // true : refuser de démarrer sans tunnel (--wait-tunnel : l'attendre).
  "requireTunnel": false,

  // Authentification. Le poste lui-même (loopback) est exempté d'appairage ;
  // un proxy/tunnel local qui relaie vers 127.0.0.1 est détecté (en-têtes
  // forwarded) et doit s'appairer. false : la loopback s'appaire aussi.
  "auth": { "exemptLoopback": true },

  // Client web. Le déploiement retenu (docs/deploy.md) : le daemon le sert lui-même,
  // en HTTPS sur l'IP du tunnel — même origine que le WebSocket. S'il est servi
  // ailleurs : false, et son origine dans "allowedOrigins".
  "serveStatic": true,
  "staticDir": "zra-client",

  // Origines autorisées à ouvrir le WebSocket. Le navigateur n'applique pas
  // la same-origin policy aux WebSockets : cette liste ferme le canal aux
  // pages tierces. Vide = l'origine propre du daemon seulement (ajoutée
  // d'office quand il sert les statiques). Client servi ailleurs : son origine ici.
  "allowedOrigins": [],

  // TLS. Absent => HTTP + ws:// : l'app fonctionne, mais le navigateur refuse
  // le service worker, l'installation sur l'écran d'accueil et le Web Push.
  // Renseigné => HTTPS + wss://, contexte sécurisé, PWA complète.
  //   "tls": { "cert": ".zra/tls/zra.crt", "key": ".zra/tls/zra.key" }   (scripts/cert.ps1, docs/deploy.md §2)
  // Relu à chaud au renouvellement ; ses noms DNS deviennent des origines autorisées.
  "tls": null,

  // Sources Zed. null => chemins par défaut de la machine.
  "zedDb": null,
  "zedSettings": null,
  "pollMs": 2000,
  "ringSize": 2000,

  // Backend d'injection :
  //   "acp"   le shim émet lui-même le session/prompt — défaut, seul supporté
  //   "uia"   EXPÉRIMENTAL. Zed émet le prompt : ZRA le tape au clavier (exige zedControl)
  //   "auto"  EXPÉRIMENTAL. "acp", repli clavier si l'agent refuse le prompt
  //   "mock"  backend bouchon, pour valider la chaîne sans agent
  "injection": "acp",

  // Pilotage de la fenêtre Zed au clavier : ouvrir une session depuis le « + »
  // du mobile, rouvrir un thread fermé, backend "uia". Zed n'expose rien à UI
  // Automation : ce sont des frappes réelles, envoyées à la fenêtre Zed et
  // interrompues si elle perd le premier plan.
  // ⚠ ACTIVÉ PAR DÉFAUT : tout appareil appairé peut faire taper Zed au clavier
  // (le daemon l'avertit au démarrage). Mettre false pour l'interdire — le « + »
  // et la réouverture des threads fermés seront alors indisponibles.
  // Mise au point : `npm run zed -- probe | recipes | try <recette>`.
  "zedControl": {
    "enabled": true,
    // "window": "zra",        // fenêtre Zed dont le titre contient ce texte
    // "dryRun": true,         // tout résoudre, ne rien envoyer
    // "cli": "C:/…/Zed/bin/zed.exe",  // ouvre le projet d'un « + » (défaut : installation standard)
    // Backend clavier : "auto" (défaut) = keyboard.ps1 sous Windows, xdotool
    // sous Linux. Sous Wayland,
    // Zed est forcé sous XWayland (WAYLAND_DISPLAY= dans son .desktop, voir
    // scripts/lib/wayland.mjs) et xdotool voit ses fenêtres.
    // Noms acceptés : "auto", "powershell", "xdotool", "none" — tout autre est
    // refusé au chargement. Un nom imposé est respecté même si l'outil est
    // absent : il échoue en disant pourquoi.
    // Surcharge ponctuelle : ZRA_ZED_KEYBOARD=none npm run daemon:dev
    // "keyboard": "auto",
    // "recipes": {            // surcharge des recettes de zra-daemon/zed/driver.js
    //   "openThread": [ { "keys": "ctrl+shift+p" }, { "wait": 400 }, … ]
    // }
  },

  // Comment lancer un agent, quand le registry de Zed ne suffit pas à le dire.
  // Sert au shim (quel binaire envelopper) comme au relecteur de threads fermés.
  // Les agents installés par Zed depuis son registry sont résolus tout seuls.
  //   "agentCommands": {
  //     "claude-acp": { "command": "node", "args": ["C:/.../claude-agent-acp/dist/index.js"] }
  //   }
  "agentCommands": {},

  // Garde-fou de tour, lu par le **shim** (ZRA_TURN_TIMEOUT_MS le surcharge).
  // Silence de l'agent — aucun session/update — au-delà duquel un tour en vol
  // est clos d'office et le dit dans le fil. Sans lui, un agent pendu ou mort
  // sans avoir clos sa requête laisse le mobile en chargement pour toujours.
  "turnTimeoutMs": 600000,

  // Cache du replay session/load et garde-fou de durée.
  "historyTtlMs": 600000,
  "historyTimeoutMs": 60000
}
