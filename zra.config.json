// Configuration de zra-daemon. Les commentaires sont tolérés (JSONC), comme
// dans le settings.json de Zed. Surchargeable par variables d'environnement
// (ZRA_PORT, ZRA_REQUIRE_TUNNEL…) et par les options de la ligne de commande.
{
  "port": 7777,

  // Écoute — spec §9. Jamais 0.0.0.0 : la loopback, le réseau local et le
  // tunnel éventuel, chacun sur son adresse. Hors loopback, appairage obligatoire.
  //
  // Réseau local (IPv4 privées) : le téléphone sur le même Wi-Fi, et à distance
  // à travers un tunnel « tout le trafic » (wg-easy, AllowedIPs 0.0.0.0/0) qui
  // débouche sur ce réseau. "lanCidrs" : le restreindre, ex. ["192.168.1.0/24"].
  "bindLan": true,
  "lanCidrs": null,
  // Tunnel monté sur le poste lui-même (facultatif) : "bindInterface" est le nom
  // de son adaptateur, "bindCidr" un repli par plage ; sinon détection par nom.
  "bindTunnel": true,
  "bindInterface": null,
  "bindCidr": null,
  // true : refuser de démarrer sans tunnel (--wait-tunnel : l'attendre).
  "requireTunnel": false,

  // Client web. Le déploiement retenu (DEPLOY.md) : le daemon le sert lui-même,
  // en HTTPS sur l'IP du tunnel — même origine que le WebSocket. S'il est servi
  // ailleurs : false, et son origine dans "allowedOrigins".
  "serveStatic": true,
  "staticDir": "zra-client",

  // Origines autorisées à ouvrir le WebSocket. Indispensable : le navigateur
  // n'applique pas la same-origin policy aux WebSockets, donc sans cette liste
  // n'importe quelle page visitée depuis le tunnel pourrait piloter le poste.
  // L'origine propre du daemon est ajoutée d'office quand il sert les statiques.
  "allowedOrigins": [],

  // TLS. Absent => HTTP + ws:// : l'app fonctionne, mais le navigateur refuse
  // le service worker, l'installation sur l'écran d'accueil et le Web Push.
  // Renseigné => HTTPS + wss://, contexte sécurisé, PWA complète.
  //   "tls": { "cert": ".zra/tls/zra.crt", "key": ".zra/tls/zra.key" }   (scripts/cert.ps1, DEPLOY.md §2)
  // Relu à chaud au renouvellement ; ses noms DNS deviennent des origines autorisées.
  "tls": null,

  // Sources Zed. null => chemins par défaut de la machine (spec §2.1).
  "zedDb": null,
  "zedSettings": null,
  "pollMs": 2000,
  "ringSize": 2000,

  // Backend d'injection (spec §6) :
  //   "acp"   le shim émet lui-même le session/prompt — défaut
  //   "uia"   Zed émet le prompt : ZRA le tape au clavier (exige zedControl)
  //   "auto"  "acp", repli clavier si l'agent refuse le prompt (risque 🔴1)
  //   "mock"  backend bouchon, pour valider la chaîne sans agent (spec §10.6)
  "injection": "acp",

  // Pilotage de la fenêtre Zed au clavier : ouvrir une session depuis le « + »
  // du mobile, rouvrir un thread fermé, backend "uia". Zed n'expose rien à UI
  // Automation : ce sont des frappes réelles, envoyées à la fenêtre Zed et
  // interrompues si elle perd le premier plan. Désactivé tant qu'on ne l'a pas
  // voulu. Mise au point : `npm run zed -- probe | recipes | try <recette>`.
  "zedControl": {
    "enabled": true,
    // "window": "zra",        // fenêtre Zed dont le titre contient ce texte
    // "dryRun": true,         // tout résoudre, ne rien envoyer
    // "cli": "C:/…/Zed/bin/zed.exe",  // ouvre le projet d'un « + » (défaut : installation standard)
    // "recipes": {            // surcharge des recettes de zra-daemon/zed/driver.js
    //   "openThread": [ { "keys": "ctrl+shift+p" }, { "wait": 400 }, … ]
    // }
  },

  // Comment lancer un agent, quand le registry de Zed ne suffit pas à le dire.
  // Sert au shim (quel binaire envelopper) comme au relecteur de threads fermés.
  // Les agents installés par Zed depuis son registry sont résolus tout seuls.
  //   "agentCommands": {
  //     "claude-acp": { "command": "node", "args": ["C:/.../claude-agent-acp/dist/index.js"] }
  //   }
  "agentCommands": {},

  // Cache du replay session/load (spec §5.2) et garde-fou de durée.
  "historyTtlMs": 600000,
  "historyTimeoutMs": 60000
}
