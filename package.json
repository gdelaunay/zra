{
  "name": "zra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ZRA — Zed Remote Agent : suivre et piloter ses threads d'agents ACP Zed depuis le mobile.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "daemon": "node --no-warnings zra-daemon/index.js",
    "daemon:dev": "node --no-warnings zra-daemon/index.js --no-tunnel",
    "mock": "node zra-client/tools/mock-server.mjs",
    "test": "node --no-warnings --test \"zra-client/test/*.test.mjs\" \"zra-daemon/test/*.test.mjs\" \"zra-shim/test/*.test.mjs\"",
    "fixture": "node --no-warnings scripts/make-fixture.mjs",
    "probe:agent": "node --no-warnings scripts/probe-agent.mjs",
    "setup": "node --no-warnings scripts/setup.mjs",
    "zed": "node --no-warnings scripts/zed.mjs",
    "themes": "node scripts/gen-themes.mjs"
  },
  "devDependencies": {
    "jsdom": "^29.1.1"
  }
}
